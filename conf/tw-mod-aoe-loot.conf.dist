########################################
# AoeLoot module configuration
########################################

[AOELoot]

#
#    AOELoot.Enable
#        Description: Enables Module
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

AOELoot.Enable = 1

#
#    AOELoot.Message
#        Description: Show informational message on player login
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

AOELoot.Message = 0

#
#    AOELoot.Range
#       Description: Maximum reach range search loot.
#       Default:    55.0
#       Range:      5.0 - 100.0
#

AOELoot.Range = 30.0

#
#    AOELoot.Group
#        Description: Enables area loot if the player is in a group
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

AOELoot.Group = 0

#
#    AOELoot.RequiredItemId
#        Description: Allows setting an item required in bags to activate area loot.
#                     A single item ID or a comma separated list of item IDs.
#                     Without the item the corpse is looted one at a time.
#        Default:     0 - No Item Required
#                     xxxxx - Specify the item ID
#

AOELoot.RequiredItemId = 0
